    {
      "parameters": {
        "agent": "conversationalAgent",
        "promptType": "define",
        "text": "=You are the Master AI Business Operations Router.\n\nIncoming request:\n{{ $json.input }}\n\nClassify the request into exactly one category:\n\nSALES\nSUPPORT\nOPERATIONS\nDOCUMENT\nGENERAL\n\nReturn ONLY valid JSON:\n\n{\n  \"category\": \"SALES|SUPPORT|OPERATIONS|DOCUMENT|GENERAL\",\n  \"priority\": \"LOW|MEDIUM|HIGH|URGENT\",\n  \"intent\": \"short description\",\n  \"needs_human\": true,\n  \"reply\": \"professional response\"\n}\n\nRules:\n- URGENT issues or angry customers must set needs_human=true.\n- Never invent prices, order numbers, refunds, policies, or company facts.\n- If uncertain, use GENERAL and needs_human=true.",
        "options": {}
      },
      "id": "f121b18f-90b9-43b0-b7ad-6a2c9fc8d676",
      "name": "Master AI Router",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -1952,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '';\n\nlet cleaned = raw.trim();\nif (cleaned.startsWith('```')) {\n  cleaned = cleaned.replace(/^```[a-z]*\\n?/, '').replace(/```$/, '').trim();\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    try {\n      parsed = JSON.parse(match[0]);\n    } catch (e2) {\n      parsed = {\n        category: 'GENERAL',\n        priority: 'MEDIUM',\n        intent: 'Unable to parse AI response',\n        needs_human: true,\n        reply: 'Thank you for your message. A human agent will review your request shortly.'\n      };\n    }\n  } else {\n    parsed = {\n      category: 'GENERAL',\n      priority: 'MEDIUM',\n      intent: 'Unable to parse AI response',\n      needs_human: true,\n      reply: 'Thank you for your message. A human agent will review your request shortly.'\n    };\n  }\n}\n\nconst validCategories = ['SALES', 'SUPPORT', 'OPERATIONS', 'DOCUMENT', 'GENERAL'];\nif (!validCategories.includes(parsed.category)) {\n  parsed.category = 'GENERAL';\n  parsed.needs_human = true;\n}\n\nconst validPriorities = ['LOW', 'MEDIUM', 'HIGH', 'URGENT'];\nif (!validPriorities.includes(parsed.priority)) {\n  parsed.priority = 'MEDIUM';\n}\n\nreturn [\n  {\n    json: {\n      category: parsed.category,\n      priority: parsed.priority,\n      intent: parsed.intent || '',\n      needs_human: parsed.needs_human === true,\n      reply: parsed.reply || '',\n      input: $('Normalize Request').first().json.input,\n      source: $('Normalize Request').first().json.source,\n      timestamp: $('Normalize Request').first().json.timestamp\n    }\n  }\n];"
      },
